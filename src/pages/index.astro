---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects
	.filter((project) => project.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const email = 'finleybatesmith@outlook.com';
const linkedinUrl = 'https://linkedin.com/in/finley-bate-smith';
const githubUrl = 'https://github.com/needmoneyfor911';
---

<Layout title="Home">
	<div class="hero-glow" aria-hidden="true"></div>
	<section class="mx-auto max-w-4xl px-6 pt-60 pb-24">
		<h1 data-reveal class="text-5xl font-bold tracking-tight mb-4">Finley Bate-Smith</h1>
		<p data-reveal style="transition-delay: 70ms" class="max-w-xl text-lg text-slate-300">
			Mechanical Engineering Student @ Queen's University
		</p>
		<div data-reveal style="transition-delay: 140ms" class="mt-8 flex gap-4">
			<a
				href="/projects"
				class="btn btn-glass rounded-full px-5 py-2.5 text-sm font-medium text-white"
			>
				View my projects
			</a>
		</div>
		<div data-reveal style="transition-delay: 200ms" class="mt-5 flex gap-4">
			<a
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
				class="icon-link text-slate-400 hover:text-electric"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
				</svg>
			</a>
			<a
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="GitHub"
				class="icon-link text-slate-400 hover:text-electric"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
					<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.03 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
				</svg>
			</a>
			<a
				href={`mailto:${email}`}
				aria-label="Email"
				class="icon-link text-slate-400 hover:text-electric"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.828.672-1.5 1.5-1.5h16.5c.828 0 1.5.672 1.5 1.5v10.5c0 .828-.672 1.5-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5V6.75Z" />
					<path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
				</svg>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16 border-t border-slate-800">
		<h2 class="text-2xl font-semibold mb-4">About</h2>
		<p class="max-w-2xl text-slate-300">
			I am a third year mechanical engineering student at Queen's University. I previously worked at the Royal Military College of Canada, helping commission a two stage light gas gun. Right now, I am working on the aerodynamics package for the car on the Queen's Formula SAE team.
		</p>
		<p class="mt-4">
			<a href="/about" class="text-electric hover:text-cantaloupe">More about me →</a>
		</p>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16 border-t border-slate-800">
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-semibold">Featured Projects</h2>
			<a href="/projects" class="text-sm text-electric hover:text-cantaloupe">View all &rarr;</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2">
			{featuredProjects.map((project, i) => (
				<a
					href={`/projects/${project.id}`}
					data-reveal
					style={`transition-delay: ${i * 60}ms`}
					class="card block p-5"
				>
					<p class="text-xs font-semibold uppercase tracking-wide text-cantaloupe mb-1">{project.data.category}</p>
					<h3 class="font-medium text-lg mb-1">{project.data.title}</h3>
					<p class="text-sm text-slate-400">{project.data.description}</p>
				</a>
			))}
			{featuredProjects.length === 0 && (
				<p class="text-slate-400 text-sm">No featured projects yet — mark one with `featured: true`.</p>
			)}
		</div>
	</section>
</Layout>
