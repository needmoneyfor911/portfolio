---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects
	.filter((project) => project.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const email = 'your-email@example.com';
const linkedinUrl = 'https://linkedin.com/in/your-profile';
---

<Layout title="Home">
	<section class="mx-auto max-w-4xl px-6 pt-60 pb-24">
		<h1 data-reveal class="text-5xl font-bold tracking-tight mb-4">Finley Bate-Smith</h1>
		<p data-reveal style="transition-delay: 70ms" class="max-w-xl text-lg text-slate-600">
			Mechanical Engineering Student @ Queen's University
		</p>
		<div data-reveal style="transition-delay: 140ms" class="mt-8 flex gap-4">
			<a
				href="/projects"
				class="btn rounded-full bg-sky-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-sky-500"
			>
				View my projects
			</a>
		</div>
		<div data-reveal style="transition-delay: 200ms" class="mt-5 flex gap-4">
			<a
				href={linkedinUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="LinkedIn"
				class="icon-link text-slate-500 hover:text-slate-900"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
				</svg>
			</a>
			<a
				href={`mailto:${email}`}
				aria-label="Email"
				class="icon-link text-slate-500 hover:text-slate-900"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0-.828.672-1.5 1.5-1.5h16.5c.828 0 1.5.672 1.5 1.5v10.5c0 .828-.672 1.5-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5V6.75Z" />
					<path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
				</svg>
			</a>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16 border-t border-slate-200">
		<h2 class="text-2xl font-semibold mb-4">About</h2>
		<p class="max-w-2xl text-slate-600">
			A couple of paragraphs about your background, what you're currently working on or learning,
			and what kind of opportunities or projects you're interested in. See the
			<a href="/about" class="text-sky-600 hover:text-sky-700"> About page</a> for more.
		</p>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16 border-t border-slate-200">
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-semibold">Featured Projects</h2>
			<a href="/projects" class="text-sm text-sky-600 hover:text-sky-700">View all &rarr;</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2">
			{featuredProjects.map((project, i) => (
				<a
					href={`/projects/${project.id}`}
					data-reveal
					style={`transition-delay: ${i * 60}ms`}
					class="card block rounded-lg border border-slate-200 p-5 hover:border-slate-400"
				>
					<h3 class="font-medium text-lg mb-1">{project.data.title}</h3>
					<p class="text-sm text-slate-500">{project.data.description}</p>
				</a>
			))}
			{featuredProjects.length === 0 && (
				<p class="text-slate-500 text-sm">No featured projects yet — mark one with `featured: true`.</p>
			)}
		</div>
	</section>
</Layout>
