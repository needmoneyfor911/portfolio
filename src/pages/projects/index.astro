---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = allProjects.filter((project) => !project.data.minor);
const minorProjects = allProjects.filter((project) => project.data.minor);
---

<Layout title="Projects">
	<section class="mx-auto max-w-4xl px-6 py-20">
		<h1 data-reveal class="text-4xl font-bold tracking-tight mb-10">Projects</h1>

		<div class="grid gap-6 sm:grid-cols-2">
			{projects.map((project, i) => (
				<a
					href={`/projects/${project.id}`}
					data-reveal
					style={`transition-delay: ${i * 60}ms`}
					class="card block p-5"
				>
					<p class="text-xs font-semibold uppercase tracking-wide text-sky-600 mb-1">{project.data.category}</p>
					<h2 class="font-medium text-lg mb-1">{project.data.title}</h2>
					<p class="text-sm text-slate-500 mb-3">{project.data.description}</p>
					<ul class="flex flex-wrap gap-2">
						{project.data.tags.map((tag) => (
							<li class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600">{tag}</li>
						))}
					</ul>
				</a>
			))}
		</div>

		{minorProjects.length > 0 && (
			<p data-reveal class="mt-10 text-sm text-slate-400">
				Also:{' '}
				{minorProjects.map((project, i) => (
					<>
						<a href={`/projects/${project.id}`} class="underline hover:text-slate-600">{project.data.title}</a>
						{i < minorProjects.length - 1 ? ', ' : ''}
					</>
				))}
			</p>
		)}
	</section>
</Layout>
