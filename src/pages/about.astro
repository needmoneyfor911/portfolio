---
import Layout from '../layouts/Layout.astro';

const email = 'finleybatesmith@outlook.com';
const linkedinUrl = 'https://linkedin.com/in/finley-bate-smith';
---

<Layout title="About">
	<section class="mx-auto max-w-4xl px-6 py-20">
		<h1 data-reveal class="text-4xl font-bold tracking-tight mb-8">About</h1>

		<div data-reveal style="transition-delay: 70ms" class="max-w-2xl space-y-6 text-slate-600">
			<p>
				I'm a third-year mechanical engineering student at Queen's University. This past summer I did research at the Royal Military College of Canada, receiving the NSERC USRA, for building and testing projectile velocity measurement systems and automating the pressure monitoring and valve control of a two-stage light gas gun. I'm currently designing and building the aerodynamics package for Queen's Formula SAE team as well as building the braking system for the Queen's Concrete Toboggan team.
			</p>
			<p>
				Outside of engineering, I'm <a href="/projects/e36-restoration" class="text-sky-600 hover:text-sky-700">restoring a 1996 BMW 328i convertible</a>, and when it is not sitting on jacks in the garage, I enjoy driving it. I also enjoy working on personal projects, staying active, and getting out to golf.
			</p>
		</div>

		<div data-reveal style="transition-delay: 140ms" class="mt-12">
			<h2 class="text-xl font-semibold mb-4">Get in touch</h2>
			<div class="flex flex-col items-start gap-4">
				<a
					href={`mailto:${email}`}
					class="btn btn-glass btn-glass-light inline-block rounded-full border border-slate-200 px-5 py-2.5 text-sm font-medium text-slate-700"
				>
					Email
				</a>
				<a
					href={linkedinUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-glass btn-glass-linkedin inline-block rounded-full px-5 py-2.5 text-sm font-medium text-white"
				>
					LinkedIn
				</a>
			</div>
		</div>
	</section>
</Layout>
