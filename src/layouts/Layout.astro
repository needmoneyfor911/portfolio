---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Portfolio of Finley Bate-Smith.' } = Astro.props;

const navLinks = [
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/resume.pdf', label: 'Resume', external: true },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Finley Bate-Smith</title>
	</head>
	<body class="min-h-screen bg-white text-slate-900 flex flex-col">
		<header class="site-header">
			<nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
				<a href="/" class="font-semibold tracking-tight text-lg">Finley Bate-Smith</a>
				<ul class="flex gap-6 text-sm">
					{navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-slate-600 hover:text-slate-900 transition-colors"
								aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noopener noreferrer' : undefined}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-slate-200">
			<div class="mx-auto max-w-4xl px-6 py-6 text-sm text-slate-500">
				&copy; {new Date().getFullYear()} Finley Bate-Smith. All rights reserved.
			</div>
		</footer>

		<script>
			// Runs in the browser (not at build time). Plain vanilla JS, no framework --
			// this is just a normal <script> tag, so it needs no client:* directive.

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// Reveal cards, hero lines, and project photos as they scroll into view.
			// Each element is revealed once, then left alone (not re-hidden on scroll back up).
			const revealTargets = document.querySelectorAll('[data-reveal], .prose figure');

			// Only hide-then-reveal elements if we can guarantee they'll be revealed.
			// The CSS that hides them is scoped to .js-reveal-ready (see global.css), so
			// skipping this entirely just leaves everything visible -- never stuck hidden.
			if (!prefersReducedMotion && 'IntersectionObserver' in window && revealTargets.length) {
				document.documentElement.classList.add('js-reveal-ready');

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
				);
				revealTargets.forEach((el) => observer.observe(el));
			}

			// Toggle the nav's hairline only once the page has actually scrolled,
			// so the translucent header reads as floating glass, not a solid bar.
			const header = document.querySelector('.site-header');
			if (header instanceof HTMLElement) {
				let ticking = false;
				const updateHeaderState = () => {
					header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
					ticking = false;
				};
				document.addEventListener(
					'scroll',
					() => {
						if (!ticking) {
							requestAnimationFrame(updateHeaderState);
							ticking = true;
						}
					},
					{ passive: true }
				);
				updateHeaderState();
			}
		</script>
	</body>
</html>
